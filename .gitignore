# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# réglages d'IDE, propres à chaque poste
.idea/

# Sources fournies par le client (39 Mo : PDF de la charte, menu, HEIC, photos
# brutes). Conservées en local, hors du dépôt : ce qui sert au site a été
# exporté dans public/brand/.
Dossier client Bluebird/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...sauf le gabarit sans secret, qui documente les variables attendues
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
